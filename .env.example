# After copying, uncomment and fill as needed. No required fields.
# 复制后按需取消注释并填写。无硬性必填项。
# cp .env.example .env

# 1. OLLAMA_URL
## Ollama API URL. For Docker backend container use OPENRAMP_DOCKER_OLLAMA_URL (default http://ollama:11434). See README.
## Ollama API 地址。Docker 后端容器用 OPENRAMP_DOCKER_OLLAMA_URL（默认 http://ollama:11434），见 README。
OLLAMA_URL=http://localhost:11434

# 2. OLLAMA_MODEL
## optional: only when the request does not bring the model, the backend defaults to (default:gemma2:2b).
## the model is from the installed Ollama list, and automatically selected, usually no need to configure this item.
## 可选：仅当请求未带 model 时作后端默认（默认 gemma2:2b）。
## 模型选自已安装的 Ollama 列表，并自动选中，一般不必配此项。

# OLLAMA_MODEL=gemma2:2b

# 3. AI_TIMEOUT
## Ollama request timeout (seconds), default 120.
## Ollama 请求超时（秒），默认 120。

AI_TIMEOUT=120

# 4. GITHUB_TOKEN
## Optional(recommended): increase GitHub API quota. example: GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
## 可选（推荐）：提高 GitHub API 限额。 例: GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

GITHUB_TOKEN=

# 5. CORS_ORIGINS
## Comma-separated. Local frontend commonly uses http://localhost:5173
## 逗号分隔。本地前端常用 http://localhost:5173
CORS_ORIGINS=*

# 6. OPENRAMP_DOCKER_OLLAMA_URL
## Docker only: when Ollama runs on the host, uncomment and change the URL.
## 仅 Docker：Ollama 在宿主机时取消注释并改地址。

# OPENRAMP_DOCKER_OLLAMA_URL=http://host.docker.internal:11434

# 7. LOG_LEVEL
## Backend Python logs; python -m startup and uvicorn in Docker: DEBUG, INFO, WARNING, ERROR, CRITICAL (WARN=WARNING).
## 后端 Python 日志、python -m 启动与 Docker 内 uvicorn：DEBUG, INFO, WARNING, ERROR, CRITICAL（WARN=WARNING）。

LOG_LEVEL=INFO

# 8. VITE_API_BASE &  VITE_USE_MOCK
## --- frontend/.env (Vite). Create a separate file if needed; do not put it here ---
## --- frontend/.env (Vite)，如有需要可另建文件，勿写在此处 ---

# VITE_API_BASE=http://localhost:8000
# VITE_USE_MOCK=false
# Optional: auto-login as user "demo" when mock build loads (GitHub Pages style demo)
# VITE_DEMO_SEED=true
